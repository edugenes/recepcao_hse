# ============================================================
# Sistema de Recepção HSE — Configurações de Ambiente
# Copie este arquivo para .env e ajuste os valores antes de iniciar
# ============================================================

# --- Servidor ---
PORT=3000
NODE_ENV=production

# --- Segurança (OBRIGATÓRIO em produção) ---
# Gere um valor seguro com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=ALTERE_ESTE_VALOR_OBRIGATORIO

# --- Administrador padrão (usado apenas na primeira inicialização) ---
# Após o primeiro login, a senha pode ser alterada pela interface.
ADMIN_EMAIL=admin@recepcao.com
ADMIN_PASSWORD=admin123

# --- CORS (opcional) ---
# Deixe vazio para permitir qualquer origem (apenas em redes internas fechadas).
# Em produção, informe as origens separadas por vírgula:
# CORS_ORIGIN=http://192.168.1.100:3000,http://recepcao.hse.local
CORS_ORIGIN=

# --- HTTPS (opcional) ---
HTTPS_ENABLE=false

# Certificado via arquivo PFX (Windows):
# SSL_PFX_PATH=C:\certs\certificado.pfx
# SSL_PFX_PASSWORD=senha_do_pfx

# Certificado via chave+certificado (Linux/PEM):
# SSL_KEY_PATH=/etc/ssl/private/recepcao.key
# SSL_CERT_PATH=/etc/ssl/certs/recepcao.crt
