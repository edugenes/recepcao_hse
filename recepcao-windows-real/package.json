{
  "name": "recepcao-windows-real",
  "version": "4.0.0",
  "description": "Sistema de Recepção HSE - Windows App REAL com DigitalPersona",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "recepcao",
    "hse",
    "digitalpersona",
    "biometric",
    "windows",
    "real"
  ],
  "author": "Sistema HSE",
  "license": "MIT",
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4"
  },
  "dependencies": {
    "sqlite3": "^5.1.6",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "jspdf": "^2.5.1"
  },
  "build": {
    "appId": "com.hse.recepcao.real",
    "productName": "Sistema de Recepção HSE - REAL",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "client/**/*",
      "biometric/**/*",
      "database/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
