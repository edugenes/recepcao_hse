{
  "name": "recepcao-desktop",
  "version": "3.0.0",
  "description": "Sistema de Recepção HSE - Aplicativo Windows com DigitalPersona 4500",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "dist": "electron-builder --publish=never",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "recepcao",
    "hse",
    "biometric",
    "digitalpersona",
    "electron",
    "desktop"
  ],
  "author": "Sistema HSE",
  "license": "MIT",
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4"
  },
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.1.5",
    "dotenv": "^16.3.1",
    "moment": "^2.29.4",
    "jspdf": "^2.5.1",
    "ws": "^8.14.2",
    "ffi-napi": "^4.0.3",
    "ref-napi": "^3.0.3"
  },
  "build": {
    "appId": "com.hse.recepcao",
    "productName": "Sistema de Recepção HSE",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "server/**/*",
      "sdk/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}